            "url": "{{baseUrl}}/api/v1/orders",
            "description": "POST /api/v1/orders — default memakai produk ID 2 sebanyak 2 unit. Jalankan Login Customer terlebih dahulu. Order ID hasilnya disimpan otomatis ke orderId.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
