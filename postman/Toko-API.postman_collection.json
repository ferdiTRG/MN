        {
          "name": "Tambah produk (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/products",
            "description": "POST /api/v1/products — membutuhkan adminToken. ID produk baru otomatis disimpan sebagai createdProductId.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Produk Tes Postman {{$timestamp}}\",\n  \"kategori\": \"Pengujian\",\n  \"harga\": 2500,\n  \"stok\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Produk berhasil dibuat', function () { pm.response.to.have.status(201); pm.expect(body.success).to.eql(true); });",
                  "if (body.success && body.data && body.data.id) pm.environment.set('createdProductId', String(body.data.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ubah produk (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/products/{{createdProductId}}",
            "description": "PUT /api/v1/products/:id — jalankan Tambah Produk terlebih dahulu agar createdProductId terisi.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Produk Tes Postman Updated\",\n  \"kategori\": \"Pengujian\",\n  \"harga\": 3000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request update diproses', function () { pm.expect([200, 404]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ubah stok (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/products/{{productId}}/stock",
            "description": "PATCH /api/v1/products/:id/stock — menambah 1 unit ke productId (default produk ID 2). Setiap request sukses mengubah stok dan menambahkan STOK_LOG.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"perubahan\": 1,\n  \"alasan\": \"Penyesuaian stok dari Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request perubahan stok diproses', function () { pm.expect([200, 400]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Hapus produk tes (Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products/{{createdProductId}}",
            "description": "DELETE /api/v1/products/:id — gunakan hanya untuk produk tes yang dibuat oleh request Tambah Produk; jangan pakai untuk produk penting atau produk yang sudah dipakai pesanan.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
