{
  "info": {
    "_postman_id": "e5a53643-32cf-4e35-bb06-b85cd980c7e4",
    "name": "Toko API - MySQL XAMPP",
    "description": "Postman collection untuk endpoint fitur yang terdefinisi di src/routes/*. Menggunakan baseUrl environment, token login otomatis, serta ID produk/pesanan otomatis untuk request create. Tidak menyertakan endpoint health check.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "description": "Registrasi, login customer/admin, dan profil. Login menyimpan token ke environment otomatis.",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "POST /api/v1/auth/register — email unik dibuat otomatis setiap kali request dikirim. Setelah berhasil, email/password baru disimpan untuk request Login Customer.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Customer Postman\",\n  \"email\": \"{{newCustomerEmail}}\",\n  \"no_hp\": \"081234567890\",\n  \"password\": \"{{newCustomerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('newCustomerEmail', 'postman.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Registrasi berhasil atau konflik email', function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });",
                  "if (pm.response.code === 201 && body.success && body.data && body.data.customer_id) {",
                  "  pm.environment.set('registeredCustomerId', String(body.data.customer_id));",
                  "  pm.environment.set('customerEmail', pm.environment.get('newCustomerEmail'));",
                  "  pm.environment.set('customerPassword', pm.environment.get('newCustomerPassword'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "POST /api/v1/auth/login — default memakai customer dummy dari database. Jika Register Customer berhasil dijalankan, environment otomatis beralih ke akun yang baru dibuat.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Login customer berhasil', function () { pm.response.to.have.status(200); pm.expect(body.success).to.eql(true); });",
                  "if (body.success && body.data && body.data.token) pm.environment.set('customerToken', body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/admin/login",
            "description": "POST /api/v1/auth/admin/login — memakai akun admin seed lokal.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Login admin berhasil', function () { pm.response.to.have.status(200); pm.expect(body.success).to.eql(true); });",
                  "if (body.success && body.data && body.data.token) pm.environment.set('adminToken', body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Profil customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/profile",
            "description": "GET /api/v1/auth/profile — membutuhkan customerToken. Jalankan Login Customer terlebih dahulu.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profil customer berhasil diambil', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Profil admin",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/profile",
            "description": "GET /api/v1/auth/profile — menggunakan token admin. Jalankan Login Admin terlebih dahulu.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profil admin berhasil diambil', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
